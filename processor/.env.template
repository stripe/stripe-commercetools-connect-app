# CoCo credentials
CTP_AUTH_URL=https://auth.[region].commercetools.com
CTP_API_URL=https://api.[region].commercetools.com
CTP_SESSION_URL=https://session.[region].commercetools.com
CTP_CHECKOUT_URL=https://checkout.[region].commercetools.com
CTP_CLIENT_ID=[composable-commerce-client-id]
CTP_CLIENT_SECRET=[composable-commerce-client-secret]
CTP_PROJECT_KEY=[composable-commerce-project-key]
CTP_JWKS_URL=https://mc-api.[region].commercetools.com/.well-known/jwks.json
CTP_JWT_ISSUER=https://mc-api.[region].commercetools.com

# Merchant return URL for redirecting the user back to the merchant website after the payment is completed
# Use it as a fallback if no merchantReturnUrl is provided in the session
MERCHANT_RETURN_URL=[Merchant-website-return-url]

STRIPE_SECRET_KEY=[Secret-key]
STRIPE_PUBLISHABLE_KEY=[Publishable-key]
STRIPE_CAPTURE_METHOD=[Posibble-values:manual|automatic|automatic_async]
STRIPE_APPEARANCE_PAYMENT_ELEMENT=[Json-value]
STRIPE_APPEARANCE_EXPRESS_CHECKOUT=[Json-value]
STRIPE_WEBHOOK_SIGNING_SECRET=[Webhook-secret-key]
STRIPE_WEBHOOK_ID=[Stripe-Webhook-ID]
STRIPE_APPLE_PAY_WELL_KNOWN=[Apple:.well-known-file-string]

# Stripe Elements initialization strategy: deferred | pi_first (case-sensitive).
# Unset means deferred. pi_first creates the PaymentIntent before the Element mounts and
# initializes Elements with its clientSecret, which bank transfers (customer_balance) and
# BLIK require — they cannot render in the deferred flow.
# DO NOT SET pi_first YET: mounting the page alone creates a PaymentIntent and a CT Payment
# with no deterministic idempotency key (KI-044), and an unfunded bank transfer makes the cart
# read as paid in full (KI-049). An invalid value does not abort startup — it logs and falls
# back to deferred, silently disabling bank transfers and BLIK.
STRIPE_PAYMENT_FLOW=[Posibble-values:deferred|pi_first]

# Optional JSON map of per-market overrides, keyed by cart country or CT store key.
# Exceptions only — the flat variables above are always the default. No wildcard key.
# Fields: flowType, captureMethod, setupFutureUsage, euBankTransferCountry (DE|FR|IE|NL).
# Bank transfers have no enable flag here by design: the rail is a Stripe Dashboard setting,
# the widget is STRIPE_PAYMENT_FLOW. This map only resolves what the Dashboard cannot see —
# manual capture excludes customer_balance, and euBankTransferCountry only picks which IBAN
# a EUR shopper sees (omit it and Stripe shows an Irish one, valid across SEPA).
# Malformed JSON or a non-object rule ABORTS startup; an invalid field value only logs and
# falls back to its default.
# Example: {"DE":{"captureMethod":"automatic","euBankTransferCountry":"DE"},"MX":{"captureMethod":"manual"}}
STRIPE_PAYMENT_BEHAVIOR_RULES=[JSON-value]


# Enable multicapture and multirefund support
# When enabled, allows multiple partial captures and multiple refunds on payments
# IMPORTANT: Requires multicapture to be enabled in your Stripe account
# Possible values: true|false (default: false)
STRIPE_ENABLE_MULTI_OPERATIONS=false

# Custom Type key for launchpad purchase order
# Default: payment-launchpad-purchase-order
CT_CUSTOM_TYPE_LAUNCHPAD_PURCHASE_ORDER_KEY=[custom-type-key]

# Custom Type key for storing Stripe Customer ID on commercetools customers
# Default: payment-connector-stripe-customer-id
CT_CUSTOM_TYPE_STRIPE_CUSTOMER_KEY=[custom-type-key]

# Custom Type key for subscription fields on line items
# Default: payment-connector-subscription-line-item-type
CT_CUSTOM_TYPE_SUBSCRIPTION_LINE_ITEM_KEY=[custom-type-key]

# Product Type key for subscription products (defines product attributes)
# Default: payment-connector-subscription-information
CT_PRODUCT_TYPE_SUBSCRIPTION_KEY=[product-type-key]
# Subscription payment handling strategy: createOrder | addPaymentToOrder
#  - createOrder (default): creates a new CT order for each subscription payment
#  - addPaymentToOrder: adds the payment to the existing order instead of creating a new one
STRIPE_SUBSCRIPTION_PAYMENT_HANDLING=createOrder
